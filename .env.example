APP_ROLE=api
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://wagering:wagering@localhost:5433/wagering
# Limite por processo. A soma de todos os processos deve ficar abaixo de max_connections do Postgres (100).
DB_POOL_MAX=10
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_WAGER_QUEUE=wager-transactions.fifo
SQS_WAGER_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wagering-events.fifo
SQS_MAX_RECEIVE_COUNT=5
