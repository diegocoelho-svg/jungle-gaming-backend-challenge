APP_ROLE=api
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://wagering:wagering@localhost:5433/wagering
# Per process. The sum across all processes must stay below Postgres max_connections (100).
DB_POOL_MAX=10
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_WAGER_QUEUE=wager-transactions.fifo
SQS_WAGER_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wagering-events.fifo
SQS_MAX_RECEIVE_COUNT=5
SQS_VISIBILITY_HEARTBEAT_MS=10000
# Optional. Serves /metrics and /health/live from the consumer and workers roles.
# METRICS_PORT=9464
